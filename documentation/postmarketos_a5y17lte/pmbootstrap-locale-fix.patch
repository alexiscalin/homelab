+    pmb.chroot.root(
+        ["sh", "-c", "echo source /etc/locale.conf > /etc/profile.d/10locale-pmos.sh"], chroot
+    )
     # add keyboard layout related to locale and layout switcher
     xkb_layout = get_xkb_layout(locale)
     xkb_vars = xkb_layout.get_profile_vars()
