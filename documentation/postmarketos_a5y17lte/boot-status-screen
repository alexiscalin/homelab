def text_rows(ch):
    rows = FONT.get(ch.upper())
    return [r + "0" for r in rows.split()] + ["000000"] if rows else ["000000"] * 8


def logo_rows(ch):
    # 6x12 cells (terminal-like 1:2 aspect) with full-cell strokes, so
    # neighbouring characters join into one outline at the right angles.
    rows = [["0"] * 6 for _ in range(12)]
    if ch == "/":
        for y in range(12):
            x = round(5 - y * 5 / 11)
            rows[y][x] = rows[y][max(x - 1, 0)] = "1"
    elif ch == "\\":
        for y in range(12):
            x = round(y * 5 / 11)
            rows[y][x] = rows[y][min(x + 1, 5)] = "1"
    elif ch == "_":
        rows[10] = rows[11] = ["1"] * 6
    return ["".join(r) for r in rows]


class Canvas:
    def __init__(self, bg):
        self.bg = bg
        self.frame = bytearray(bg * (W * H))
        self.cache = {}

    def _row_bytes(self, bits, scale, fg):
        key = (bits, scale, fg)
        if key not in self.cache:
            self.cache[key] = b"".join((fg if b == "1" else self.bg) * scale for b in bits)
        return self.cache[key]

    def text(self, x, y, text, fg, scale, rows_for=text_rows):
        for ch in text:
            if x + 6 * scale > W:
                break
            if ch != " ":
                for gy, bits in enumerate(rows_for(ch)):
                    if "1" not in bits:
                        continue
                    row = self._row_bytes(bits, scale, fg)
                    for sy in range(scale):
                        off = ((y + gy * scale + sy) * W + x) * 4
                        self.frame[off:off + len(row)] = row
            x += 6 * scale

    def logo(self, y, fg, scale=5):
        x = 60
        for i, line in enumerate(LOGO):
            self.text(x, y + i * 12 * scale, line, fg, scale, rows_for=logo_rows)

    def show(self):
        fd = os.open("/dev/fb0", os.O_RDWR)
        try:
            fb = mmap.mmap(fd, W * H * 4, mmap.MAP_SHARED,
                           mmap.PROT_READ | mmap.PROT_WRITE)
            fb[:] = self.frame
            var = bytearray(160)
            fcntl.ioctl(fd, FBIOGET_VSCREENINFO, var)
            fcntl.ioctl(fd, FBIOPAN_DISPLAY, var)
            fb.close()
        finally:
            os.close(fd)


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def os_name():
    for line in read("/etc/os-release").splitlines():
        if line.startswith("PRETTY_NAME="):
            return line.split("=", 1)[1].strip('"')
    return "?"


def uptime():
    secs = int(float(read("/proc/uptime", "0").split()[0]))
    d, rem = divmod(secs, 86400)
    h, rem = divmod(rem, 3600)
    m = rem // 60
    return "%dD %02dH %02dM" % (d, h, m) if d else "%dH %02dM" % (h, m)


def temps():
    """SoC = hottest zone; battery from the supply (3.18) or the mainline
    battery NTC zone ("battery-thermal")."""
    zones, bat = [], None
    for z in sorted(os.listdir("/sys/class/thermal")):
        t = read("/sys/class/thermal/%s/temp" % z)
        if not (z.startswith("thermal_zone") and t.lstrip("-").isdigit()):
            continue
        if read("/sys/class/thermal/%s/type" % z) == "battery-thermal":
            bat = int(t) / 1000
        else:
            zones.append(int(t) / 1000)
    soc = "%d*" % max(zones) if zones else "?"
    supply = read(battery_dir() + "/temp")
    if supply.lstrip("-").isdigit():
        bat = int(supply) / 10
    return soc, ("%d*" % bat if bat is not None else "?")


def battery_dir():
    """3.18 exposes "battery"; mainline the s2mu004 fuel gauge."""
    base = "/sys/class/power_supply"
    if os.path.isdir(base + "/battery"):
        return base + "/battery"
    for name in sorted(os.listdir(base)) if os.path.isdir(base) else []:
        if read("%s/%s/type" % (base, name)) == "Battery":
            return "%s/%s" % (base, name)
    return base + "/battery"


def battery():
    bat = battery_dir()
    cap = read(bat + "/capacity", "?")
    status = read(bat + "/status", "?").upper()
    return "%s%% %s" % (cap, status)


def memory():
    info = {}
    for line in read("/proc/meminfo").splitlines():
        k, v = line.split(":", 1)
        info[k] = int(v.split()[0])
    total = info.get("MemTotal", 0) // 1024
    used = total - info.get("MemAvailable", 0) // 1024
    return "%d / %d MB" % (used, total)


def local_ipv4s():
    addrs, prev = [], None
    for line in read("/proc/net/fib_trie").splitlines():
        line = line.strip()
        if line.startswith("/32 host LOCAL") and prev:
            if not prev.startswith("127.") and prev not in addrs:
                addrs.append(prev)
        elif line.startswith("|--"):
            prev = line[3:].strip()
    return addrs


def wifi():
    if read("/sys/class/net/wlan0/operstate") != "up" or read("/sys/class/net/wlan0/carrier") != "1":
        return "DOWN", RED
    if not any(not a.startswith("172.16.") for a in local_ipv4s()):
        return "NO ADDRESS", AMBER
    gateway = None
    for line in read("/proc/net/route").splitlines()[1:]:
        f = line.split()
        if f[0] == "wlan0" and f[1] == "00000000":
            gateway = ".".join(str(b) for b in reversed(bytes.fromhex(f[2])))
    if not gateway:
        return "NO ROUTE", AMBER
    for line in read("/proc/net/arp").splitlines()[1:]:
        f = line.split()
        if f[0] == gateway and f[2] == "0x2":
            return "CONNECTED", GREEN
    return "NO GATEWAY", AMBER


def ssh():
    pid = read("/run/sshd.pid")
    if not pid or not os.path.exists("/proc/" + pid):
        return "OFF", RED
    sessions = 0
    for table in ("/proc/net/tcp", "/proc/net/tcp6"):
        for line in read(table).splitlines()[1:]:
            f = line.split()
            if f[1].endswith(":0016") and f[3] == "01":
                sessions += 1
    return "ON  %d SESSION%s" % (sessions, "" if sessions == 1 else "S"), GREEN


class StuckWatch:
    """Notice network daemons stuck in uninterruptible sleep, keep evidence."""

    NAMES = ("NetworkManager", "wpa_supplicant")

    def __init__(self):
        self.since = None
        self.dumped = False

    def _stuck(self):
        pids = []
        for pid in filter(str.isdigit, os.listdir("/proc")):
            stat = read("/proc/%s/stat" % pid)
            if not stat:
                continue
            name = stat[stat.find("(") + 1:stat.rfind(")")]
            state = stat[stat.rfind(")") + 2:stat.rfind(")") + 3]
            if state == "D" and name in self.NAMES:
                pids.append((pid, name))
        return pids

    def check(self):
        pids = self._stuck()
        if not pids:
            self.since, self.dumped = None, False
            return "OK", GREEN
        now = time.monotonic()
        self.since = self.since or now
        if now - self.since < STUCK_AFTER:
            return "OK", GREEN
        if not self.dumped:
            self._dump()
            self.dumped = True
        return "STUCK", RED

    def _dump(self):
        path = "/var/log/net-stuck-%s.txt" % time.strftime("%Y%m%d-%H%M%S")
        try:
            with open(path, "w") as out:
                for pid in filter(str.isdigit, os.listdir("/proc")):
                    stat = read("/proc/%s/stat" % pid)
                    if stat and stat[stat.rfind(")") + 2] == "D":
                        out.write("=== %s %s\n" % (pid, read("/proc/%s/cmdline" % pid).replace("\0", " ")))
                        out.write("wchan: %s\n%s\n\n" % (read("/proc/%s/wchan" % pid),
                                                         read("/proc/%s/stack" % pid)))
                out.write("=== dmesg\n")
                out.write(subprocess.run(["dmesg"], capture_output=True, text=True,
                                         timeout=10).stdout[-200000:])
        except (OSError, subprocess.SubprocessError):
            pass


def status_screen(stuck):
    c = Canvas(BLACK)
    c.logo(40, GREEN)
    soc, bat = temps()
    rows = [
        ("DEVICE", "GALAXY A5 (2017)", GREEN),
        ("OS", os_name(), GREEN),
        ("KERNEL", os.uname().release, GREEN),
        ("UPTIME", uptime(), GREEN),
        ("LOAD", " ".join(read("/proc/loadavg").split()[:3]), GREEN),
        ("TEMP", "SOC %s  BAT %s" % (soc, bat), GREEN),
        ("BATTERY", battery(), GREEN),
        ("MEMORY", memory(), GREEN),
        ("WIFI", *wifi()),
        ("SSH", *ssh()),
        ("NETWORK", *stuck.check()),
    ]
    y = 680
    for label, value, color in rows:
        c.text(60, y, label, DIM, 5)
        c.text(60 + 9 * 30, y, value, color, 5)
        y += 80
    c.text(60, H - 80, "UPDATED " + time.strftime("%H:%M:%S"), DIM, 4)
    c.show()


def set_panel(on):
    # decon_blank() ignores repeated on/off requests ("already enabled").
    with open(FB_BLANK, "w") as f:
        f.write("0" if on else "4")  # FB_BLANK_UNBLANK / FB_BLANK_POWERDOWN


def input_fds():
    fds = []
    with open("/proc/bus/input/devices") as f:
        blocks = f.read().split("\n\n")
    for block in blocks:
        if not any('Name="%s"' % name in block for name in INPUTS):
            continue
        for word in block.split():
            if word.startswith("event"):
                fds.append(os.open("/dev/input/" + word, os.O_RDONLY | os.O_NONBLOCK))
    return fds


def had_activity(fd):
    try:
        data = os.read(fd, EVENT_SIZE * 64)
    except BlockingIOError:
        return False
    for off in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
        ev_type = int.from_bytes(data[off + 16:off + 18], "little")
        if ev_type in (EV_KEY, EV_ABS):
            return True
    return False


def daemon():
    fds = input_fds()
    stuck = StuckWatch()
    awake = True
    last_input = time.monotonic()
    status_screen(stuck)
    last_draw = time.monotonic()
    while True:
        readable, _, _ = select.select(fds, [], [], 2)
        now = time.monotonic()
        if any([had_activity(fd) for fd in readable]):
            last_input = now
            if not awake:
                set_panel(True)
                awake = True
                last_draw = 0
        if awake and now - last_input > SLEEP_AFTER:
            set_panel(False)
            awake = False
        if awake and now - last_draw >= REFRESH:
            status_screen(stuck)
            last_draw = time.monotonic()
        elif not awake:
            stuck.check()  # keep collecting evidence while the screen is off


def once():
    status_screen(StuckWatch())


def off():
    set_panel(True)
    c = Canvas(BLACK)
    c.logo(40, RED)
    c.text(60, 760, "SHUTTING", RED, 10)
    c.text(60, 880, "DOWN", RED, 10)
    c.show()


if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else "daemon"
    {"daemon": daemon, "once": once, "off": off}[mode]()
