#!/usr/bin/python3
"""Status screen for the Galaxy A5 2017 (samsung-a5y17lte) framebuffer.

The decon driver only exposes the real framebuffer through mmap (write() goes
nowhere), and the command-mode panel only shows a new frame after an
FBIOPAN_DISPLAY. The panel then keeps the image on its own.

Everything shown is read from /proc and /sys only: the qcacld wlan driver
sometimes holds the rtnl lock forever, and anything using netlink or network
ioctls (ip, nmcli, iw) then hangs.

Modes:
  daemon  draw the status screen, refresh it every REFRESH seconds, power the
          panel down after SLEEP_AFTER seconds without input, wake on any key
  once    draw the status screen once
  off     draw the shutdown screen
"""
import fcntl
import mmap
import os
import select
import subprocess
import sys
import time

W, H = 1080, 1920
FBIOGET_VSCREENINFO = 0x4600
FBIOPAN_DISPLAY = 0x4606
FB_BLANK = "/sys/class/graphics/fb0/blank"
SLEEP_AFTER = 30
REFRESH = 10
STUCK_AFTER = 20
INPUTS = ("gpio_keys", "sec_touchkey", "sec_touchscreen",  # 3.18
          "GPIO Keys",  # mainline gpio-keys (DT label)
          "Zinitix Capacitive TouchScreen")  # mainline touchscreen
EV_KEY, EV_ABS = 1, 3
EVENT_SIZE = 24  # struct input_event on aarch64


